# Generated by omaboot for the theme "{{THEME_ID}}". Do not edit by hand:
# `omaboot apply` rewrites this file from theme.toml every time.
#
# Every value below arrived as data from the theme model. Nothing in this file
# is produced by substituting text into a shipped script.

global.background_red = {{BG_R}};
global.background_green = {{BG_G}};
global.background_blue = {{BG_B}};
global.foreground_red = {{FG_R}};
global.foreground_green = {{FG_G}};
global.foreground_blue = {{FG_B}};

Window.SetBackgroundTopColor(global.background_red, global.background_green, global.background_blue);
Window.SetBackgroundBottomColor(global.background_red, global.background_green, global.background_blue);

# "boot", "resume", "shutdown", "reboot", "updates" and "system-upgrade" are the
# modes plymouthd reports. Everything that differs per mode is decided here,
# once, and read from these two flags afterwards.
global.mode = Plymouth.GetMode();
global.is_shutdown = (global.mode == "shutdown" || global.mode == "reboot");
global.is_unlock = (global.mode == "boot" || global.mode == "resume");

# The logo's size and place can differ between the unlock and the shutdown
# screen; theme.toml's [logo.shutdown] is what decides the second. The width
# is a share of the screen's width, so the logo is the same size on every
# display and whatever the size of the file.
if (global.is_shutdown) {
  global.logo_width = {{SHUTDOWN_LOGO_WIDTH}};
  global.logo_position = "{{SHUTDOWN_LOGO_POSITION}}";
  global.logo_offset_x = {{SHUTDOWN_LOGO_OFFSET_X}};
  global.logo_offset_y = {{SHUTDOWN_LOGO_OFFSET_Y}};
} else {
  global.logo_width = {{UNLOCK_LOGO_WIDTH}};
  global.logo_position = "{{UNLOCK_LOGO_POSITION}}";
  global.logo_offset_x = {{UNLOCK_LOGO_OFFSET_X}};
  global.logo_offset_y = {{UNLOCK_LOGO_OFFSET_Y}};
}
global.prompt_style = "{{PROMPT_STYLE}}";
global.unlock_progress = "{{UNLOCK_PROGRESS}}";
global.shutdown_progress = "{{SHUTDOWN_PROGRESS}}";
global.unlock_message = "{{UNLOCK_MESSAGE}}";
global.shutdown_message = "{{SHUTDOWN_MESSAGE}}";

if (global.is_shutdown) {
  global.progress_style = global.shutdown_progress;
  global.theme_message = global.shutdown_message;
} else {
  global.progress_style = global.unlock_progress;
  global.theme_message = global.unlock_message;
}

#--------------------------------------- Images ---------------------------------------

if (global.is_shutdown) {
  logo.original_image = Image("{{SHUTDOWN_LOGO_FILE}}");
} else {
  logo.original_image = Image("logo.png");
}

# Sized in layout(), from the window's width; this is only the placeholder.
logo.image = logo.original_image;
logo.sprite = Sprite(logo.image);
logo.sprite.SetOpacity(1);

entry.image = Image("entry.png");
entry.sprite = Sprite(entry.image);
entry.sprite.SetOpacity(0);

lock.image = Image("lock.png");
lock.sprite = Sprite(lock.image);
lock.sprite.SetOpacity(0);

bullet.image = Image("bullet.png");
bullet.sprites = [];

progress_box.image = Image("progress_box.png");
progress_box.sprite = Sprite(progress_box.image);
progress_box.sprite.SetOpacity(0);

progress_bar.original_image = Image("progress_bar.png");
progress_bar.sprite = Sprite();
progress_bar.sprite.SetOpacity(0);

message.sprite = Sprite();
message.sprite.SetOpacity(0);

typed.sprite = Sprite();
typed.sprite.SetOpacity(0);

#--------------------------------------- Layout ---------------------------------------

# Upstream computes every position once, at load. A display that appears after
# plymouthd started therefore leaves the splash off centre. layout() is called
# again from the refresh callback whenever the window size changes.

global.laid_out_width = 0;
global.laid_out_height = 0;

fun layout() {
  screen_width = Window.GetWidth();
  screen_height = Window.GetHeight();

  # The logo takes its share of the screen width, keeping its aspect ratio.
  if (screen_width != global.laid_out_width) {
    logo_target_width = Math.Int(screen_width * global.logo_width);
    if (logo_target_width < 1) logo_target_width = 1;
    logo_target_height = Math.Int(logo_target_width * logo.original_image.GetHeight() / logo.original_image.GetWidth());
    if (logo_target_height < 1) logo_target_height = 1;
    logo.image = logo.original_image.Scale(logo_target_width, logo_target_height);
    logo.sprite.SetImage(logo.image);
  }

  logo_x = screen_width / 2 - logo.image.GetWidth() / 2;
  if (global.logo_position == "top") {
    logo_y = screen_height / {{TOP_POSITION_DIVISOR}};
  } else {
    logo_y = screen_height / 2 - logo.image.GetHeight() / 2;
  }
  logo_x = logo_x + global.logo_offset_x;
  logo_y = logo_y + global.logo_offset_y;
  logo.sprite.SetPosition(logo_x, logo_y, 1);

  global.entry_x = screen_width / 2 - entry.image.GetWidth() / 2;
  global.entry_y = logo_y + logo.image.GetHeight() + {{LOGO_ENTRY_GAP}};
  entry.sprite.SetPosition(global.entry_x, global.entry_y, 10001);

  # The lock glyph sits just left of the entry, slightly shorter than it.
  lock_height = entry.image.GetHeight() * {{LOCK_HEIGHT_RATIO}};
  lock_scale = lock_height / lock.image.GetHeight();
  lock_width = lock.image.GetWidth() * lock_scale;
  lock.sprite.SetImage(lock.image.Scale(lock_width, lock_height));
  lock.sprite.SetPosition(global.entry_x - lock_width - {{LOCK_ENTRY_GAP}},
                          global.entry_y + entry.image.GetHeight() / 2 - lock_height / 2,
                          10001);

  progress_box.sprite.SetPosition(
    screen_width / 2 - progress_box.image.GetWidth() / 2,
    global.entry_y + entry.image.GetHeight() / 2 - progress_box.image.GetHeight() / 2,
    0);
  progress_bar.sprite.SetPosition(
    screen_width / 2 - progress_bar.original_image.GetWidth() / 2,
    global.entry_y + entry.image.GetHeight() / 2 - progress_bar.original_image.GetHeight() / 2,
    1);

  message.sprite.SetPosition(
    screen_width / 2 - message.width / 2,
    global.entry_y + entry.image.GetHeight() + {{MESSAGE_GAP}},
    10000);

  global.laid_out_width = screen_width;
  global.laid_out_height = screen_height;
}

fun set_message(text) {
  if (text == "") {
    message.sprite.SetOpacity(0);
    message.width = 0;
    return;
  }
  image = Image.Text(text, global.foreground_red, global.foreground_green, global.foreground_blue);
  message.sprite.SetImage(image);
  message.width = image.GetWidth();
  message.sprite.SetOpacity(1);
}

if (global.is_shutdown) {
  set_message(global.theme_message);
} else {
  set_message("");
}
layout();

#--------------------------------------- Progress --------------------------------------

global.animation_frame = 0;
global.fake_progress = 0.0;
global.fake_progress_active = 0;
global.fake_progress_start_time = 0.0;
global.max_progress = 0.0;
global.password_shown = 0;
global.spinner_phase = 0;

# The same easing upstream uses: ease-out quadratic towards 70% over 15s, with a
# ratchet so the bar never moves backwards.
global.fake_progress_limit = 0.7;
global.fake_progress_duration = 15.0;

fun update_progress_bar(progress) {
  if (global.progress_style != "bar") return;
  if (progress <= global.max_progress) return;

  global.max_progress = progress;
  width = Math.Int(progress_bar.original_image.GetWidth() * progress);
  if (width < 1) width = 1;
  progress_bar.sprite.SetImage(
    progress_bar.original_image.Scale(width, progress_bar.original_image.GetHeight()));
}

fun show_progress() {
  if (global.progress_style == "none") return;
  progress_box.sprite.SetOpacity(1);
  progress_bar.sprite.SetOpacity(1);
}

fun hide_progress() {
  progress_box.sprite.SetOpacity(0);
  progress_bar.sprite.SetOpacity(0);
}

fun start_fake_progress() {
  if (global.progress_style == "none") return;
  global.fake_progress_active = 1;
  global.animation_frame = 0;
  global.max_progress = 0.0;
  global.fake_progress = 0.0;
  global.fake_progress_start_time = 0.0;
}

fun stop_fake_progress() {
  global.fake_progress_active = 0;
}

# The spinner is a pulse of the progress box rather than a rotating sprite,
# because a rotation needs a frame set this theme does not ship. See
# docs/DECISIONS.md.
fun animate_spinner() {
  global.spinner_phase = global.spinner_phase + 1;
  if (global.spinner_phase > 50) global.spinner_phase = 0;
  half = 25;
  if (global.spinner_phase < half) {
    opacity = global.spinner_phase / half;
  } else {
    opacity = (50 - global.spinner_phase) / half;
  }
  progress_box.sprite.SetOpacity(0.25 + opacity * 0.75);
}

fun refresh_callback() {
  global.animation_frame++;

  if (Window.GetWidth() != global.laid_out_width || Window.GetHeight() != global.laid_out_height) {
    layout();
  }

  if (global.progress_style == "spinner" && (global.is_shutdown || global.password_shown == 1)) {
    animate_spinner();
  }

  if (global.fake_progress_active == 1 && global.progress_style == "bar") {
    elapsed = global.animation_frame / 50.0;
    ratio = elapsed / global.fake_progress_duration;
    if (ratio > 1.0) ratio = 1.0;
    eased = 1 - ((1 - ratio) * (1 - ratio));
    global.fake_progress = eased * global.fake_progress_limit;
    update_progress_bar(global.fake_progress);
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
  # duration and progress freeze while the drive is being decrypted, so the
  # first reading is remembered and real progress is only trusted once it moves.
  if (global.fake_progress_start_time == 0.0) {
    global.fake_progress_start_time = duration;
  }
  if (duration > global.fake_progress_start_time && progress > global.fake_progress) {
    stop_fake_progress();
    update_progress_bar(progress);
  }
}

Plymouth.SetBootProgressFunction(progress_callback);

#--------------------------------------- Password ---------------------------------------

fun hide_password_dialog() {
  lock.sprite.SetOpacity(0);
  entry.sprite.SetOpacity(0);
  for (index = 0; bullet.sprites[index]; index++) {
    bullet.sprites[index].SetOpacity(0);
  }
  typed.sprite.SetOpacity(0);
}

fun show_password_dialog() {
  lock.sprite.SetOpacity(1);
  entry.sprite.SetOpacity(1);
  if (global.is_unlock) {
    set_message(global.theme_message);
    layout();
  }
}

fun draw_bullets(count) {
  max_bullets = {{MAX_BULLETS}};
  if (count > max_bullets) count = max_bullets;
  for (index = 0; index < count; index++) {
    if (!bullet.sprites[index]) {
      bullet.sprites[index] = Sprite(bullet.image.Scale({{BULLET_SIZE}}, {{BULLET_SIZE}}));
    }
    bullet.sprites[index].SetPosition(
      global.entry_x + {{ENTRY_INSET}} + index * {{BULLET_PITCH}},
      global.entry_y + entry.image.GetHeight() / 2 - {{BULLET_SIZE}} / 2,
      10002);
    bullet.sprites[index].SetOpacity(1);
  }
}

fun draw_typed_text(text) {
  image = Image.Text(text, global.foreground_red, global.foreground_green, global.foreground_blue);
  typed.sprite.SetImage(image);
  typed.sprite.SetPosition(
    global.entry_x + {{ENTRY_INSET}},
    global.entry_y + entry.image.GetHeight() / 2 - image.GetHeight() / 2,
    10002);
  typed.sprite.SetOpacity(1);
}

fun display_password_callback(prompt, bullets) {
  global.password_shown = 1;
  stop_fake_progress();
  hide_progress();
  show_password_dialog();

  for (index = 0; bullet.sprites[index]; index++) {
    bullet.sprites[index].SetOpacity(0);
  }

  if (global.prompt_style == "bullets") {
    draw_bullets(bullets);
  } else if (global.prompt_style == "asterisks") {
    stars = "";
    for (index = 0; index < bullets && index < {{MAX_BULLETS}}; index++) {
      stars = stars + "*";
    }
    draw_typed_text(stars);
  } else if (global.prompt_style == "counter") {
    draw_typed_text(bullets + " characters");
  }
}

fun display_normal_callback() {
  hide_password_dialog();
  if (global.is_unlock) {
    set_message("");
  }
  if (global.is_unlock && global.password_shown == 1) {
    show_progress();
    start_fake_progress();
  }
  if (global.is_shutdown) {
    show_progress();
    start_fake_progress();
  }
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

#--------------------------------------- Messages ---------------------------------------

fun display_message_callback(text) {
  set_message(text);
  layout();
}

fun hide_message_callback(text) {
  if (global.is_shutdown) {
    set_message(global.theme_message);
  } else {
    set_message("");
  }
  layout();
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

fun quit_callback() {
  hide_password_dialog();
  hide_progress();
  message.sprite.SetOpacity(0);
}

Plymouth.SetQuitFunction(quit_callback);

if (global.is_shutdown) {
  show_progress();
  start_fake_progress();
}
